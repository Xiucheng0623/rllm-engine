"""RLLM Worker注册中心 + DiskLLMInferWorker 磁盘分页推理Worker

架构:
  L0 WorkerBase    - 抽象基类
  L1 WorkerRegistry - 单例注册中心
  L2 DiskLLMInferWorker - 核心推理Worker（磁盘分页+真实Mistral forward）
  L3 CPUFallbackWorker - 兼容回退Worker
"""
from __future__ import annotations

import abc
import asyncio
import time
import gc
from dataclasses import dataclass, field
from pathlib import Path
from typing import Any, Dict, List, Optional, Tuple

from loguru import logger

from rllm_agent_core.config.hermes_config import GlobalHermesConfig, load_global_config

logger.add(
    Path("D:/AI_RLLM/logs") / "worker_{time}.log",
    rotation="50 MB",
    retention="7 days",
    encoding="utf-8",
)


# ============================================================
# 数据结构
# ============================================================
@dataclass
class WorkerContext:
    """Worker执行上下文"""
    task_id: str
    prompt: str
    max_new_tokens: int = 256
    temperature: float = 0.7
    top_p: float = 0.9
    extra_params: Dict[str, Any] = field(default_factory=dict)


@dataclass
class WorkerResult:
    """Worker执行结果"""
    task_id: str
    success: bool
    generated_text: str = ""
    error_msg: str = ""
    latency_sec: float = 0.0
    peak_memory_mb: float = 0.0
    tokens_generated: int = 0
    io_metrics: Dict[str, float] = field(default_factory=dict)


# ============================================================
# 1. Worker 抽象基类
# ============================================================
class WorkerBase(abc.ABC):
    """Worker抽象基类"""

    name: str = "base"

    @abc.abstractmethod
    async def execute(self, ctx: WorkerContext) -> WorkerResult:
        """执行推理任务"""
        raise NotImplementedError

    @abc.abstractmethod
    def health_check(self) -> bool:
        """健康检查"""
        raise NotImplementedError


# ============================================================
# 2. Worker 全局注册中心
# ============================================================
class WorkerRegistry:
    """Worker单例注册中心"""
    _instance: Optional["WorkerRegistry"] = None
    _workers: Dict[str, WorkerBase] = {}

    def __new__(cls) -> "WorkerRegistry":
        if cls._instance is None:
            cls._instance = super().__new__(cls)
            cls._instance._workers = {}
        return cls._instance

    def register(self, name: str, worker: WorkerBase) -> None:
        """注册Worker"""
        self._workers[name] = worker
        logger.info(f"[RLLM-WorkerRegistry] 已注册 Worker: {name}")

    def unregister(self, name: str) -> None:
        """注销Worker"""
        self._workers.pop(name, None)

    def get(self, name: str) -> Optional[WorkerBase]:
        """获取Worker实例"""
        return self._workers.get(name)

    def list_names(self) -> List[str]:
        """列出所有已注册Worker"""
        return list(self._workers.keys())


def register_default_workers() -> None:
    """注册默认全部Worker，DiskLLMInfer作为首选推理Worker"""
    registry = WorkerRegistry()
    registry.register("disk_llm_infer", DiskLLMInferWorker())
    registry.register("cpu_fallback", CPUFallbackWorker())
    logger.info(f"[RLLM-WorkerRegistry] 默认Worker注册完成: {registry.list_names()}")


def get_worker(name: str = "disk_llm_infer") -> WorkerBase:
    """获取指定Worker，不存在则抛异常"""
    registry = WorkerRegistry()
    worker = registry.get(name)
    if worker is None:
        register_default_workers()
        worker = registry.get(name)
    if worker is None:
        raise KeyError(f"Worker不存在: {name}, 已注册: {registry.list_names()}")
    return worker


# ============================================================
# 3. 核心 DiskLLMInferWorker：磁盘分页推理Worker
# ============================================================
class DiskLLMInferWorker(WorkerBase):
    """RLLM 磁盘分页推理专属Worker

    工作流：
      1. 加载全局配置 (2GB缓冲硬限)
      2. 初始化磁盘分页调度器、KV溢出管理器、内存硬锁
      3. 加载Mistral模型组件(embed/norm/lm_head常驻 + DecoderLayer逐层复用)
      4. 任务级指标采集（延迟、峰值内存、IO阻塞）
    """
    name: str = "disk_llm_infer"

    def __init__(self) -> None:
        self._config: GlobalHermesConfig = load_global_config()
        self._scheduler_initialized: bool = False
        self._memory_lock: Optional[object] = None
        self._page_scheduler: Optional[object] = None
        self._kv_manager: Optional[object] = None
        # === KV cache 复用字段（prefill 建立，decode_step 增量更新）===
        self._kv_cache: List[Any] = []
        self._kv_past_len: int = 0
        self._kv_task_id: str = ""

    # ----------------------------------------------------------------
    def _lazy_init_scheduler(self) -> None:
        """懒加载磁盘调度器 + Mistral模型组件"""
        if self._scheduler_initialized:
            return
        try:
            from rllm_disk_engine.memory_lock.global_memory_lock import GlobalMemoryLock
            from rllm_disk_engine.scheduler.async_page_scheduler import AsyncPageScheduler
            from rllm_disk_engine.kv_manager.kv_spill_manager import KVSpillManager
            import json as _json
            import torch as _torch
            from safetensors import safe_open

            self._memory_lock = GlobalMemoryLock(
                limit_gb=self._config.memory_limit.cpu_infer_buffer_gb,
                monitor_interval_ms=self._config.memory_limit.monitor_interval_ms,
                force_swap=self._config.memory_limit.force_swap_when_exceed,
            )

            # === 加载 Mistral 模型结构 ===
            raw_parent = self._config.disk_offload.model_shards_dir / "_raw"
            raw_dir = None
            if raw_parent.exists():
                for sub in sorted(raw_parent.iterdir()):
                    if (sub / "config.json").exists():
                        raw_dir = sub
                        break
            if raw_dir is None:
                raise FileNotFoundError("未找到_raw下的模型目录")

            from transformers import MistralConfig
            mistral_cfg = MistralConfig.from_pretrained(str(raw_dir))
            self._mistral_config = mistral_cfg
            self._num_layers = mistral_cfg.num_hidden_layers
            self._hidden_size = mistral_cfg.hidden_size
            logger.info(f"[RLLM-InferWorker] Mistral配置: {self._num_layers}层 hidden={self._hidden_size} vocab={mistral_cfg.vocab_size}")

            # weight_map
            idx_path = raw_dir / "model.safetensors.index.json"
            weight_map = _json.loads(idx_path.read_text(encoding="utf-8"))["weight_map"]

            # === 常驻组件: embed_tokens / norm / lm_head ===
            from transformers.models.mistral.modeling_mistral import MistralRMSNorm, MistralDecoderLayer

            # embed_tokens
            st_file = weight_map.get("model.embed_tokens.weight")
            embed_weight = None
            if st_file:
                with safe_open(str(raw_dir / st_file), framework="pt", device="cpu") as f:
                    embed_weight = f.get_tensor("model.embed_tokens.weight")
            self._embed_tokens = _torch.nn.Embedding(mistral_cfg.vocab_size, mistral_cfg.hidden_size, dtype=_torch.bfloat16)
            if embed_weight is not None:
                self._embed_tokens.weight.data = embed_weight
            del embed_weight
            logger.info(f"[RLLM-InferWorker] embed_tokens: {self._embed_tokens.weight.shape}")

            # norm
            st_file = weight_map.get("model.norm.weight")
            norm_weight = None
            if st_file:
                with safe_open(str(raw_dir / st_file), framework="pt", device="cpu") as f:
                    norm_weight = f.get_tensor("model.norm.weight")
            self._norm = MistralRMSNorm(mistral_cfg.hidden_size, eps=mistral_cfg.rms_norm_eps)
            if norm_weight is not None:
                self._norm.weight.data = norm_weight.to(_torch.bfloat16)
            del norm_weight

            # lm_head
            st_file = weight_map.get("lm_head.weight")
            lm_weight = None
            if st_file:
                with safe_open(str(raw_dir / st_file), framework="pt", device="cpu") as f:
                    lm_weight = f.get_tensor("lm_head.weight")
            self._lm_head = _torch.nn.Linear(mistral_cfg.hidden_size, mistral_cfg.vocab_size, bias=False, dtype=_torch.bfloat16)
            if lm_weight is not None:
                self._lm_head.weight.data = lm_weight
            del lm_weight
            logger.info(f"[RLLM-InferWorker] lm_head: {self._lm_head.weight.shape}")

            # === 单个 DecoderLayer (逐层复用) ===
            self._decoder_layer = MistralDecoderLayer(mistral_cfg, layer_idx=0).to(_torch.bfloat16)
            self._decoder_layer.eval()
            logger.info(f"[RLLM-InferWorker] DecoderLayer创建: {sum(p.numel() for p in self._decoder_layer.parameters())/1e6:.0f}M params")

            # === 调度器 (传入 safetensors 路径和 weight_map) ===
            self._page_scheduler = AsyncPageScheduler(
                shards_dir=self._config.disk_offload.model_shards_dir,
                prefetch_layers_ahead=self._config.disk_offload.prefetch_layers_ahead,
                prefetch_threads=self._config.disk_offload.prefetch_threads,
                enable_mmap=self._config.disk_offload.enable_mmap,
                buffer_capacity_gb=self._config.disk_offload.cpu_buffer_limit_gb,
                raw_model_dir=raw_dir,
                weight_map=weight_map,
            )

            self._kv_manager = KVSpillManager(
                temp_dir=self._config.disk_offload.offload_temp_dir / "kv_cache",
                spill_threshold_mb=self._config.disk_offload.kv_spill_threshold_mb,
            )
            self._scheduler_initialized = True
            self._raw_model_dir = raw_dir
            self._weight_map = weight_map
            logger.info("[RLLM-InferWorker] 磁盘调度器+Mistral组件初始化完成")
            # === v2.0 显存持久层初始化 ===
            self._v2_enabled: bool = False
            self._vram_prefill_done: bool = False
            try:
                self._lazy_init_v2()
            except Exception as exc_v2:
                logger.warning(f"[RLLM-InferWorker] v2 初始化失败, 回退 v1 模式: {exc_v2}")
                self._v2_enabled = False
        except Exception as exc:
            logger.error(f"[RLLM-InferWorker] 调度器初始化失败: {exc}")
            raise

    # ----------------------------------------------------------------
    def _lazy_init_v2(self) -> None:
        """v2.0 显存持久层初始化

        作用:
          1. 创建 ZeroCopyShardLoader 单例, 打开所有 safetensors 持久句柄
          2. 创建 VRAMCachePool 单例 (绑定 HotColdEvictor)
          3. 把 embed_tokens / norm / lm_head 搬到 cuda 常驻
          4. 标记 v2 模式启用

        异常:
          RuntimeError: CUDA 不可用 或 显存池初始化失败
        """
        import torch
        try:
            from rllm_disk_engine.zero_copy_loader.zero_copy_shard_loader import (
                ZeroCopyShardLoader,
            )
            from rllm_disk_engine.vram_pool.vram_cache_pool import (
                VRAMCachePool,
                VRAMLayerEntry,
            )
            from rllm_disk_engine.vram_pool.hot_cold_evictor import HotColdEvictor

            if not torch.cuda.is_available():
                raise RuntimeError(
                    "v2 模式需要 CUDA, 当前 torch.cuda.is_available()=False"
                )

            device = torch.device("cuda")

            # 1. 零拷贝加载器 (持久句柄)
            zero_loader = ZeroCopyShardLoader()
            if not zero_loader._handles:
                zero_loader.initialize(
                    raw_model_dir=self._raw_model_dir,
                    weight_map=self._weight_map,
                    num_layers=self._num_layers,
                )
            self._zero_loader = zero_loader

            # 2. 显存缓存池 (单例)
            vram_pool = VRAMCachePool(
                reserve_gb=2.0,
                evict_threshold_pct=0.85,
            )
            self._vram_pool = vram_pool

            # 3. 冷热置换器
            evictor = HotColdEvictor(
                vram_pool=vram_pool,
                evict_dir=self._config.disk_offload.offload_temp_dir / "evicted_layers",
                lru_weight_vs_freq=0.5,
                num_layers=self._num_layers,
            )
            # 注入模块工厂 (fetch_back 时重建 DecoderLayer)
            evictor.attach_factory(
                factory=self._make_decoder_layer_factory(),
                quant_bits=4,
            )
            vram_pool.attach_evictor(evictor)
            self._evictor = evictor

            # 4. embed/norm/lm_head 搬到 cuda 常驻
            self._embed_tokens = self._embed_tokens.to(device)
            self._norm = self._norm.to(device)
            self._lm_head = self._lm_head.to(device)

            # 5. v2 模式标志
            self._v2_enabled: bool = True
            self._vram_prefill_done: bool = False

            logger.success(
                f"[RLLM-InferWorker] v2 显存持久层初始化完成: "
                f"device={torch.cuda.get_device_name(0)} "
                f"VRAM容量={vram_pool._capacity_bytes/1024**3:.1f}GB "
                f"embed/norm/lm_head已常驻VRAM"
            )
        except Exception as exc:
            logger.error(f"[RLLM-InferWorker] v2 初始化失败: {exc}")
            self._v2_enabled = False
            raise

    def _make_decoder_layer_factory(self):
        """创建 DecoderLayer 工厂闭包 (供 VRAMPool.prefill_load_all 使用)"""
        import torch
        from transformers.models.mistral.modeling_mistral import MistralDecoderLayer

        def factory(layer_idx: int) -> torch.nn.Module:
            module = MistralDecoderLayer(self._mistral_config, layer_idx=layer_idx)
            module = module.to(torch.bfloat16)
            module.eval()
            return module

        return factory

    # ----------------------------------------------------------------
    async def execute(self, ctx: WorkerContext) -> WorkerResult:
        """执行磁盘分页推理

        Args:
            ctx: Worker执行上下文，含prompt/超参/指标缓存

        Returns:
            WorkerResult: 含生成文本、延迟、内存、IO指标
        """
        self._lazy_init_scheduler()
        start_ts = time.time()
        io_metrics: Dict[str, float] = {}
        peak_mem_mb: float = 0.0
        generated: str = ""

        try:
            # ---- 内存硬锁：进入保护区 ----
            assert self._memory_lock is not None
            await self._memory_lock.acquire()

            # ---- 加载分词器（离线模式） ----
            tokenizer = self._load_tokenizer_offline()
            tokens = self._encode_prompt(tokenizer, ctx.prompt)
            io_metrics["prompt_tokens"] = float(len(tokens))

            # ---- 异步磁盘分页逐层推理 ----
            assert self._page_scheduler is not None
            assert self._kv_manager is not None

            generated_tokens: List[int] = []
            total_layers_read_ms: float = 0.0
            io_block_ms: float = 0.0

            # === KV cache 复用：prefill 一次完整过32层 + decode N 次每层只加载1层 ===
            # 任务切换时重置 KV cache（不同 prompt 不可复用）
            if self._kv_task_id != ctx.task_id:
                self._kv_cache = [None] * self._num_layers
                self._kv_past_len = 0
                self._kv_task_id = ctx.task_id

            # Step 0: prefill（首轮，过完所有层，建立 KV cache）
            infer_t0 = time.time()
            first_tok, layer_read_ms = await self._prefill(tokens, ctx)
            total_layers_read_ms += layer_read_ms
            io_block_ms += max(0.0, (time.time() - infer_t0) * 1000 - layer_read_ms)
            generated_tokens.append(first_tok)
            peak_mem_mb = max(peak_mem_mb, self._memory_lock.current_usage_mb)

            # Step 1+: decode（增量，每层只加载1层权重 + 复用KV）
            for step in range(1, ctx.max_new_tokens):
                current_mb = self._memory_lock.current_usage_mb
                peak_mem_mb = max(peak_mem_mb, current_mb)

                infer_t0 = time.time()
                next_token, layer_read_ms = await self._decode_step(generated_tokens[-1], ctx)
                total_layers_read_ms += layer_read_ms
                io_block_ms += max(0.0, (time.time() - infer_t0) * 1000 - layer_read_ms)

                # KV溢出保护
                await self._kv_manager.check_and_spill_if_needed()
                generated_tokens.append(next_token)

                if next_token in (tokenizer.eos_token_id or -1,):
                    break

            # 任务结束清理 KV cache，释放内存
            self._kv_cache = [None] * self._num_layers
            self._kv_past_len = 0
            gc.collect()

            generated = tokenizer.decode(generated_tokens, skip_special_tokens=True)

            # 汇总IO指标
            io_metrics.update({
                "total_layer_read_ms": total_layers_read_ms,
                "avg_layer_read_ms": total_layers_read_ms / max(1, len(generated_tokens)),
                "io_block_ms": io_block_ms,
                "kv_spill_count": float(await self._kv_manager.get_spill_count()),
                "tokens_generated": float(len(generated_tokens)),
            })

            return WorkerResult(
                task_id=ctx.task_id,
                success=True,
                generated_text=generated,
                latency_sec=time.time() - start_ts,
                peak_memory_mb=peak_mem_mb,
                tokens_generated=len(generated_tokens),
                io_metrics=io_metrics,
            )

        except Exception as exc:
            logger.exception(f"[RLLM-InferWorker] 任务 {ctx.task_id} 失败: {exc}")
            return WorkerResult(
                task_id=ctx.task_id,
                success=False,
                error_msg=str(exc),
                latency_sec=time.time() - start_ts,
                peak_memory_mb=peak_mem_mb,
                io_metrics=io_metrics,
            )
        finally:
            if self._memory_lock is not None:
                self._memory_lock.release()

    # ----------------------------------------------------------------
    def health_check(self) -> bool:
        """健康检查：配置+磁盘调度器"""
        try:
            self._lazy_init_scheduler()
            assert self._config.disk_offload.cpu_buffer_limit_gb <= 2.0
            return True
        except Exception as exc:
            logger.warning(f"[RLLM-InferWorker] 健康检查失败: {exc}")
            return False

    # ----------------------------------------------------------------
    def _load_tokenizer_offline(self):
        """离线模式加载D盘tokenizer，优先use_fast=False，fallback到_raw真实模型目录。"""
        try:
            from transformers import AutoTokenizer
            candidate_dirs = [self._config.disk_offload.model_shards_dir / "tokenizer"]
            raw_parent = self._config.disk_offload.model_shards_dir / "_raw"
            if raw_parent.exists():
                candidate_dirs.extend(sorted(raw_parent.iterdir()))
            last_err = None
            for cand in candidate_dirs:
                if not cand.exists():
                    continue
                try:
                    tok = AutoTokenizer.from_pretrained(
                        str(cand), local_files_only=True, trust_remote_code=False, use_fast=False,
                    )
                    if tok.eos_token_id is None:
                        tok.eos_token_id = 2
                    if tok.pad_token_id is None:
                        tok.pad_token_id = tok.eos_token_id
                    return tok
                except Exception as exc:
                    last_err = exc
                    continue
            raise FileNotFoundError(
                f"tokenizer加载失败，last_err={last_err}。候选={[str(c) for c in candidate_dirs]}"
            )
        except Exception as exc:
            logger.error(f"[RLLM-InferWorker] tokenizer失败: {exc}")
            raise

    # ----------------------------------------------------------------
    def _encode_prompt(self, tokenizer: Any, prompt: str) -> List[int]:
        """编码Prompt，带异常保护"""
        enc = tokenizer(prompt, return_tensors="np", truncation=True, max_length=4096)
        return enc["input_ids"].tolist()[0]

    # ----------------------------------------------------------------
    async def _prefill(
        self,
        prompt_tokens: List[int],
        ctx: WorkerContext,
    ) -> Tuple[int, float]:
        """v2.0 Prefill: 一次性装入VRAM + 单次前向 + KV留VRAM

        流程:
          1. 首次调用: vram_pool.prefill_load_all 把所有层装入VRAM常驻
          2. embed (VRAM) -> 逐层 vram_pool.get_layer (零IO) -> KV 留 VRAM
          3. norm + lm_head + argmax

        Args:
            prompt_tokens: prompt token id 列表
            ctx: Worker 上下文

        Returns:
            (下一个token_id, 所有层磁盘读取总耗时ms)
        """
        import torch
        import time as _time
        num_layers = self._num_layers
        device = self._vram_pool._device

        # === 首次启动: 一次性装入所有层 ===
        if not self._vram_prefill_done:
            t_load0 = _time.time()
            loaded, load_sec = await self._vram_pool.prefill_load_all(
                layer_loader=self._zero_loader,
                layer_module_factory=self._make_decoder_layer_factory(),
                num_layers=num_layers,
                quant_bits=4,
            )
            self._vram_prefill_done = True
            logger.info(
                f"[RLLM-InferWorker] v2 Prefill 装入完成: "
                f"{loaded}/{num_layers} 层, 耗时={load_sec:.1f}s"
            )
            if loaded < num_layers:
                logger.warning(
                    f"[RLLM-InferWorker] 仅装入 {loaded}/{num_layers} 层, "
                    f"剩余层将走冷热淘汰路径"
                )

        # === 重置 KV cache ===
        self._kv_cache = [None] * num_layers
        self._kv_past_len = 0

        # === embed (VRAM) ===
        input_ids = torch.tensor([prompt_tokens], dtype=torch.long, device=device)
        seq_len = input_ids.shape[1]
        position_ids = torch.arange(seq_len, dtype=torch.long, device=device).unsqueeze(0)

        with torch.no_grad():
            hidden = self._embed_tokens(input_ids)

        # === 逐层前向 (从 VRAM 取, 零磁盘IO) ===
        total_read_ms: float = 0.0  # v2 模式下磁盘读取应为 0
        for layer_idx in range(num_layers):
            module = await self._vram_pool.get_layer(layer_idx)
            if module is None:
                logger.warning(
                    f"[RLLM-InferWorker] 层 {layer_idx} 未在 VRAM, 跳过"
                )
                continue

            with torch.no_grad():
                layer_out = module(
                    hidden,
                    attention_mask=None,
                    position_ids=position_ids,
                    past_key_value=None,
                    use_cache=True,
                )
                hidden = layer_out[0]
                new_kv = layer_out[1]

            # KV cache 留 VRAM (供 decode_step 复用)
            self._kv_cache[layer_idx] = new_kv

        self._kv_past_len = seq_len

        # === norm + lm_head + argmax (常驻 VRAM) ===
        with torch.no_grad():
            hidden = self._norm(hidden)
            logits = self._lm_head(hidden[:, -1:, :])
            next_tok = int(torch.argmax(logits[0, -1, :]).item())

        return next_tok, total_read_ms


    # ----------------------------------------------------------------
    async def _decode_step(
        self,
        last_token: int,
        ctx: WorkerContext,
    ) -> Tuple[int, float]:
        """v2.0 Decode: 纯GPU forward, 零磁盘IO

        流程:
          1. 单 token embed (VRAM)
          2. 逐层 vram_pool.get_layer (VRAM命中) + 复用 past KV
          3. norm + lm_head + argmax

        验收点: total_read_ms 必须 == 0

        Args:
            last_token: 上一步生成的 token id
            ctx: Worker 上下文

        Returns:
            (下一个token_id, 0.0)  # 磁盘读取耗时为 0
        """
        import torch
        num_layers = self._num_layers
        device = self._vram_pool._device
        past_len = self._kv_past_len

        # === embed ===
        input_ids = torch.tensor([[last_token]], dtype=torch.long, device=device)
        position_ids = torch.tensor([[past_len]], dtype=torch.long, device=device)

        with torch.no_grad():
            hidden = self._embed_tokens(input_ids)

        # === 逐层前向 (零磁盘IO, 全部 VRAM 命中) ===
        total_read_ms: float = 0.0  # ★ 验收点: 必须 == 0
        for layer_idx in range(num_layers):
            module = await self._vram_pool.get_layer(layer_idx)
            if module is None:
                logger.warning(
                    f"[RLLM-InferWorker] decode 层 {layer_idx} 未在 VRAM, 跳过"
                )
                continue

            past_kv = self._kv_cache[layer_idx]

            with torch.no_grad():
                layer_out = module(
                    hidden,
                    attention_mask=None,
                    position_ids=position_ids,
                    past_key_value=past_kv,
                    use_cache=True,
                )
                hidden = layer_out[0]
                new_kv = layer_out[1]

            # 用新 KV (含 past+cur) 替换 cache
            self._kv_cache[layer_idx] = new_kv

        self._kv_past_len = past_len + 1

        # === norm + lm_head + argmax ===
        with torch.no_grad():
            hidden = self._norm(hidden)
            logits = self._lm_head(hidden[:, -1:, :])
            next_tok = int(torch.argmax(logits[0, -1, :]).item())

        return next_tok, total_read_ms


# ============================================================
# 4. 兼容回退 Worker
# ============================================================
class CPUFallbackWorker(WorkerBase):
    """CPU回退Worker（仅在磁盘调度器不可用时使用）"""
    name: str = "cpu_fallback"

    async def execute(self, ctx: WorkerContext) -> WorkerResult:
        start = time.time()
        try:
            return WorkerResult(
                task_id=ctx.task_id,
                success=True,
                generated_text=f"[CPU回退] 输入长度: {len(ctx.prompt)}",
                latency_sec=time.time() - start,
                peak_memory_mb=0.0,
            )
        except Exception as exc:
            return WorkerResult(
                task_id=ctx.task_id,
                success=False,
                error_msg=str(exc),
                latency_sec=time.time() - start,
            )

    def health_check(self) -> bool:
        return True
